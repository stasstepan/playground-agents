# Прод-конфигурация. Скопируйте: cp .env.prod.example .env
# и замените все CHANGE_ME.

# ── PostgreSQL ────────────────────────────────────────────────────
# Строка подключения к вашей базе (контейнер или managed-сервис).
DATABASE_URL=postgresql+asyncpg://playground:CHANGE_ME_DB_PASSWORD@postgres:5432/playground

# ── Безопасность ──────────────────────────────────────────────────
# openssl rand -hex 32
SECRET_KEY=CHANGE_ME_64_HEX
ADMIN_USER=admin
# Только bcrypt-хэш (plain text не поддерживается):
# python -c "import bcrypt;print(bcrypt.hashpw(b'PASSWORD', bcrypt.gensalt()).decode())"
ADMIN_HASH=$2b$12$CHANGE_ME

# Cookie админки передаётся только по HTTPS
SESSION_SECURE=true

# Лимит запросов на клиента в минуту
RATE_LIMIT_PER_MINUTE=300

# ── Публичные адреса ──────────────────────────────────────────────
# Публичный адрес площадки: подставляется в /agents.md и в ссылки интерфейса.
PUBLIC_BASE_URL=https://playground.example.com
# Домены, которым разрешён CORS (через запятую).
CORS_ORIGINS=https://playground.example.com

# ── Docker / reverse-proxy ────────────────────────────────────────
# Внешняя docker-сеть, в которой работает ваш reverse-proxy.
WEB_NETWORK=playground-net
# Подсеть reverse-proxy: из неё доверяем X-Forwarded-For.
FORWARDED_ALLOW_IPS=172.16.0.0/12
