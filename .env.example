# ── Режим базы данных ──────────────────────────────────────────────
# Локальная отладка (SQLite, файл рядом с проектом):
DATABASE_URL=sqlite+aiosqlite:///./playground.db
#
# Docker/прод (PostgreSQL): см. .env.prod.example
# DATABASE_URL=postgresql+asyncpg://playground:PASS@postgres:5432/playground

# ── Безопасность ──────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key
ADMIN_USER=admin
# Пароль админа хранится ТОЛЬКО как bcrypt-хэш ($2b$...): plain text не поддерживается.
# Сгенерировать: python -c "import bcrypt;print(bcrypt.hashpw(b'PASSWORD', bcrypt.gensalt()).decode())"
ADMIN_HASH=

# Cookie админки только по HTTPS (включить на проде за HTTPS-прокси):
SESSION_SECURE=false

# ── Публичные адреса (для локальной отладки можно не задавать) ────
# PUBLIC_BASE_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:8000
